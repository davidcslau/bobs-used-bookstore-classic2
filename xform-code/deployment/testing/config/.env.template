# =============================================
# Bob's Used Bookstore - Testing Environment
# Environment Variables Template
# =============================================

# =============================================
# Application Configuration
# =============================================
ASPNETCORE_ENVIRONMENT=Testing
ASPNETCORE_URLS=http://+:8080

# =============================================
# Database Configuration (AWS PostgreSQL)
# =============================================
# Update these values with your AWS RDS PostgreSQL instance
DB_HOST=your-rds-instance.region.rds.amazonaws.com
DB_PORT=5432
DB_NAME=bookstore
DB_USER=bookstore_user
DB_PASSWORD=your-secure-password-here

# Connection String (auto-constructed from above)
ConnectionStrings__BookstoreDatabaseConnection=Host=${DB_HOST};Port=${DB_PORT};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD};

# =============================================
# Service Configuration
# =============================================
Services__Authentication=local
Services__Database=aws
Services__FileService=aws
Services__ImageValidationService=local
Services__LoggingService=aws

# =============================================
# AWS Configuration
# =============================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key

# =============================================
# AWS S3 File Service Configuration
# =============================================
Files__BucketName=bookstore-files-bucket
Files__CloudFrontDomain=your-cloudfront-domain.cloudfront.net

# =============================================
# AWS CloudWatch Logging Configuration
# =============================================
Logging__CloudWatch__LogGroup=/aws/bookstore/testing
Logging__CloudWatch__Region=${AWS_REGION}

# =============================================
# Authentication Configuration (Local)
# =============================================
# For local authentication, no additional config needed
# For AWS Cognito (if switching to aws), uncomment below:
# Authentication__Cognito__ClientId=your-cognito-client-id
# Authentication__Cognito__MetadataAddress=https://cognito-idp.region.amazonaws.com/poolId/.well-known/openid-configuration
# Authentication__Cognito__CognitoDomain=https://your-domain.auth.region.amazoncognito.com

# =============================================
# Image Validation Configuration (Local)
# =============================================
# For local image validation, no additional config needed
# Local validation uses basic image format checking

# =============================================
# Application Settings
# =============================================
AllowedHosts=*

# =============================================
# Optional: SSL/TLS Configuration
# =============================================
# ASPNETCORE_Kestrel__Certificates__Default__Password=your-cert-password
# ASPNETCORE_Kestrel__Certificates__Default__Path=/app/certs/certificate.pfx
