{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "BookstoreDatabaseConnection": "Host=${DB_HOST};Port=${DB_PORT:5432};Database=${DB_NAME};Username=${DB_USER};Password=${DB_PASSWORD}"
  },
  "AppSettings": {
    "Environment": "Testing",
    "Services/Authentication": "local",
    "Services/Database": "aws",
    "Services/FileService": "aws",
    "Services/ImageValidationService": "local",
    "Services/LoggingService": "aws",
    "Authentication/Cognito/LocalClientId": "${COGNITO_CLIENT_ID}",
    "Authentication/Cognito/MetadataAddress": "${COGNITO_METADATA_ADDRESS}",
    "Files/BucketName": "${S3_BUCKET_NAME}",
    "Files/CloudFrontDomain": "${CLOUDFRONT_DOMAIN}"
  },
  "AWS": {
    "Region": "us-east-1"
  }
}
